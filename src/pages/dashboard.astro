---
import Topbar from "@/components/Topbar.astro";
import Layout from "@/layouts/Layout.astro";

const { user } = Astro.locals;
---

<Layout title="Panel">
  <div class="bg-garden min-h-screen p-4 text-emerald-950">
    <div class="mx-auto flex min-h-[calc(100vh-2rem)] w-full max-w-5xl flex-col py-4">
      <Topbar />
      <div class="flex flex-1 items-center justify-center">
        <div class="garden-card rounded-xl border p-8 text-center backdrop-blur-md">
          <p class="mb-2 text-sm font-semibold tracking-[0.25em] text-emerald-700 uppercase">Planer ogrodu</p>
          <h1 class="mb-4 text-3xl font-bold text-emerald-950">Panel</h1>
          <p class="text-emerald-900/75">
            Witaj, <span class="font-semibold text-emerald-950">{user?.email}</span>
          </p>
          <p class="mt-2 text-sm text-emerald-900/55">Ta strona jest dostępna tylko dla zalogowanych użytkowników.</p>
          <form method="POST" action="/api/auth/signout" class="mt-6">
            <button
              type="submit"
              class="rounded-sm border border-emerald-300 bg-white/75 px-4 py-2 text-sm font-semibold text-emerald-800 transition-colors hover:bg-emerald-50 focus-visible:ring-2 focus-visible:ring-emerald-300 focus-visible:outline-none"
            >
              Wyloguj
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</Layout>
