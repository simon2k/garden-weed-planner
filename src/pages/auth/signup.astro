---
import Layout from "@/layouts/Layout.astro";
import SignUpForm from "@/components/auth/SignUpForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Rejestracja">
  <div class="bg-auth-garden flex min-h-screen items-center justify-center p-4">
    <div class="garden-card w-full max-w-sm rounded-xl border p-8 text-emerald-950 backdrop-blur-md">
      <p class="mb-2 text-center text-sm font-semibold tracking-[0.25em] text-emerald-700 uppercase">Planer ogrodu</p>
      <h1 class="mb-6 text-center text-2xl font-bold text-emerald-950">Utwórz konto</h1>
      <SignUpForm serverError={error} client:load />
      <p class="mt-4 text-center text-sm text-emerald-900/70">
        Masz już konto? <a href="/auth/signin" class="font-semibold text-emerald-700 hover:underline">Zaloguj się</a>
      </p>
    </div>
  </div>
</Layout>
