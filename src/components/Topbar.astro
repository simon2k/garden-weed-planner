---
const { user } = Astro.locals;
---

<div
  class="mb-4 flex flex-col gap-3 rounded-xl border border-emerald-200/70 bg-white/75 px-4 py-3 text-sm text-emerald-950 shadow-sm shadow-emerald-900/5 backdrop-blur-md sm:flex-row sm:items-center sm:justify-between"
>
  {
    user ? (
      <>
        <span class="truncate text-emerald-900/70">{user.email}</span>
        <div class="flex flex-wrap items-center gap-3">
          <a
            href="/garden"
            class="font-semibold text-emerald-700 transition-colors hover:text-emerald-900 hover:underline"
          >
            Ogród
          </a>
          <form method="POST" action="/api/auth/signout">
            <button
              type="submit"
              class="font-semibold text-emerald-700 transition-colors hover:text-emerald-900 hover:underline"
            >
              Wyloguj
            </button>
          </form>
        </div>
      </>
    ) : (
      <>
        <span class="text-emerald-900/70">Niezalogowany</span>
        <div class="flex flex-wrap gap-3">
          <a
            href="/auth/signin"
            class="font-semibold text-emerald-700 transition-colors hover:text-emerald-900 hover:underline"
          >
            Zaloguj
          </a>
          <a
            href="/auth/signup"
            class="font-semibold text-emerald-700 transition-colors hover:text-emerald-900 hover:underline"
          >
            Utwórz konto
          </a>
        </div>
      </>
    )
  }
</div>
