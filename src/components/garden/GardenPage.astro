---
import Topbar from "@/components/Topbar.astro";
import { GardenQueue } from "@/components/garden/GardenQueue";

const { user } = Astro.locals;
---

<main class="bg-garden min-h-screen p-4 text-emerald-950">
  <div class="garden-dashboard-bridge mx-auto flex min-h-[calc(100vh-2rem)] w-full max-w-5xl flex-col py-4">
    <Topbar />

    <section class="flex flex-1 flex-col justify-center gap-8 py-8">
      <div class="max-w-3xl space-y-4">
        <p class="text-sm font-semibold tracking-[0.35em] text-emerald-700 uppercase">Planer ogrodu</p>
        <h1 class="text-4xl font-bold text-emerald-950 md:text-5xl">Kolejka rabat do pielenia</h1>
        <p class="max-w-2xl text-base leading-7 text-emerald-900/75">
          Witaj, <span class="font-semibold text-emerald-950">{user?.email}</span>. Dodawaj rabaty i sprawdzaj, które
          miejsca wymagają pielenia jako pierwsze na podstawie zachwaszczenia, terminu, ściółki, powierzchni i
          szacowanego nakładu pracy.
        </p>
      </div>

      <GardenQueue client:load />
    </section>
  </div>
</main>
