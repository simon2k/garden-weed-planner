---
import Topbar from "@/components/Topbar.astro";
---

<div class="bg-auth-garden relative min-h-screen w-full overflow-hidden text-emerald-950">
  <div class="pointer-events-none absolute top-20 left-8 h-48 w-48 rounded-full bg-lime-200/35 blur-3xl"></div>
  <div class="pointer-events-none absolute right-10 bottom-24 h-64 w-64 rounded-full bg-pink-200/30 blur-3xl"></div>

  <div class="relative z-10 p-4 sm:p-8">
    <Topbar />

    <div class="mx-auto flex max-w-4xl flex-col items-center justify-center px-4 py-24 text-center sm:py-32 lg:py-36">
      <p class="mb-4 text-sm font-semibold tracking-[0.35em] text-emerald-700 uppercase">Lekki planer ogrodu</p>
      <h1 class="mb-6 text-5xl leading-tight font-bold text-emerald-950 sm:text-6xl lg:text-7xl">
        Garden Weed Planner
      </h1>
      <p class="mb-10 max-w-2xl text-lg leading-8 text-emerald-900/75 sm:text-xl">
        Planuj pielenie rabat, oceniaj pilność prac i wracaj do ogrodu z jasną kolejką działań.
      </p>
      <div class="flex flex-col gap-4 sm:flex-row">
        <a
          href="/auth/signin"
          class="inline-flex items-center justify-center rounded-sm bg-emerald-700 px-6 py-3 text-base font-semibold text-white shadow-sm shadow-emerald-900/15 transition-colors hover:bg-emerald-600 focus-visible:ring-2 focus-visible:ring-emerald-300 focus-visible:outline-none"
        >
          Zaloguj się
        </a>
        <a
          href="/auth/signup"
          class="inline-flex items-center justify-center rounded-sm border border-emerald-300 bg-white/70 px-6 py-3 text-base font-semibold text-emerald-800 shadow-sm transition-colors hover:bg-white focus-visible:ring-2 focus-visible:ring-emerald-300 focus-visible:outline-none"
        >
          Utwórz konto
        </a>
      </div>
    </div>

    <div class="mx-auto grid max-w-4xl grid-cols-1 gap-6 px-4 pb-24 sm:grid-cols-3">
      <div class="garden-card rounded-xl border p-6 backdrop-blur-md">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="mb-4 text-emerald-700"
        >
          <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
        <h3 class="mb-2 text-lg font-semibold text-emerald-950">Priorytety rabat</h3>
        <p class="text-sm leading-relaxed text-emerald-900/65">
          Zapisuj rabaty i sprawdzaj, które miejsca wymagają pielenia w pierwszej kolejności.
        </p>
      </div>

      <div class="garden-card rounded-xl border p-6 backdrop-blur-md">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="mb-4 text-emerald-700"
        >
          <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
          <polyline points="2 17 12 22 22 17"></polyline>
          <polyline points="2 12 12 17 22 12"></polyline>
        </svg>
        <h3 class="mb-2 text-lg font-semibold text-emerald-950">Obserwacje chwastów</h3>
        <p class="text-sm leading-relaxed text-emerald-900/65">
          Notuj nasilenie, fazę wzrostu i cechy chwastów, aby lepiej planować kolejne prace.
        </p>
      </div>

      <div class="garden-card rounded-xl border p-6 backdrop-blur-md">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="mb-4 text-emerald-700"
        >
          <polyline points="16 18 22 12 16 6"></polyline>
          <polyline points="8 6 2 12 8 18"></polyline>
        </svg>
        <h3 class="mb-2 text-lg font-semibold text-emerald-950">Historia pielenia</h3>
        <p class="text-sm leading-relaxed text-emerald-900/65">
          Rejestruj wykonane prace i korzystaj z podpowiedzi, kiedy wrócić do danej rabaty.
        </p>
      </div>
    </div>
  </div>
</div>
